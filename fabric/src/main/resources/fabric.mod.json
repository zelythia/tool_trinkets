{
  "schemaVersion": 1,
  "id": "tool_trinkets",
  "version": "${version}",
  "name": "Tool Trinkets",
  "description": "This mod adds trinket slots for minecraft tools that also work with AutoTools!",
  "authors": [
    "lukas/zelythia"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/tool_trinkets",
    "issues": "https://github.com/zelythia/tool_trinkets/issues",
    "sources": "https://github.com/zelythia/tool_trinkets"
  },
  "license": "MIT",
  "icon": "assets/tool_trinkets/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.zelythia.tool_trinkets.fabric.ToolTrinketsFabric"
    ],
    "client": [
      "net.zelythia.tool_trinkets.fabric.client.ToolTrinketsFabricClient"
    ]
  },
  "mixins": [
    "tool_trinkets.mixins.json"
  ],
  "depends": {
    "minecraft": [
      "1.21",
      "1.21.1"
    ],
    "fabricloader": ">=0.17.2",
    "java": ">=17",
    "fabric-api": "*",
    "trinkets": "*"
  },
  "recommends": {
    "autotools": ">=3.3.2"
  }
}
